[gtcaca_theme]
# cacamacs' own default theme.
#
# gtcaca loads its own themes/default first and then layers this file over it
# (cacamacs registers this directory with gtcaca_theme_add_search_dir), so only
# the colours that differ from gtcaca's need naming here — everything left out
# keeps whatever gtcaca chose. A user's ~/.config/gtcaca/themes/default is
# applied after this one and wins over both.
#
# This file colours the *chrome*: windows, buttons, the status bar, the editing
# surface. Syntax colours — comment, string, keyword, selection, current line —
# live in ~/.cacamacs/theme instead; see docs/ccm-theme.example.
#
# Colour names: black blue green cyan red magenta brown lightgray darkgray
# lightblue lightgreen lightcyan lightred lightmagenta yellow white.

# An Emacs-like editing surface: near-black with light-grey text, and the same
# whether or not the pane holds focus — focus is shown by the cursor, not by a
# background tint. (gtcaca brightens the focused textview to white; cacamacs
# deliberately does not.)
background   = #1e1a2e        # a dark purple
foreground   = #d0d0e0
current_line = #2a2440        # highlight on the caret's line
selection_fg = black
selection_bg = #4a4a80
textview_bg      = black
textview_fg      = lightgray
textviewfocus_bg = black
textviewfocus_fg = lightgray

# code colourization (syntax styles)
comment  = #6a7a6a
string   = #98c878
number   = #80d0d0
keyword  = #c890f0
bracket  = #e0e0a0
operator = #b0b0c0

